# Required: OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# Set to "true" to use pre-built demo scenarios instead of live Coral queries
DEMO_MODE=true

# LLM model to use via OpenRouter (default: deepseek/deepseek-v4-flash)
LLM_MODEL=deepseek/deepseek-v4-flash

# Optional: set to "true" when Coral CLI is installed and sources are configured
# CORAL_AVAILABLE=true

# Optional: custom Coral binary path
# CORAL_BIN_PATH=/usr/local/bin/coral
